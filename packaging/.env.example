# Copy this file to .env. Keep .env private.
OBSERVATORY_IMAGE=__OBSERVATORY_IMAGE__
# Set a unique password BEFORE first start: use 32 or more letters/digits.
# Avoid punctuation here because the password is embedded in a connection URL.
POSTGRES_PASSWORD=
OBSERVATORY_PORT=8080
SAMPLE_INTERVAL=10s
# Docker Desktop and standard Linux Docker:
DOCKER_SOCKET_PATH=/var/run/docker.sock
